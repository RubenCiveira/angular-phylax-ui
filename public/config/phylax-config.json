{
  "$schema": "./phylax-config.schema.json",
  "meta": {
    "title": "config de phylax"
  },
  "api": {
    "net-civeira-phylax": {
      "identity": "main",
      "url": "http://localhost:8090/api"
    }
  },
  "i18n": {
    "default-lang": "es",
    "available-langs": ["es", "en", "pt", "fr", "de"]
  },
  "theme": {
    "mode": "auto",
    "product-name": "Phylax",
    "logo": "assets/img/logo-75x75.png",
    "tokens": {}
  },
  "tenant": {
    "default": "main"
  },
  "actions": {
    "import": {
      "roles": ["*"],
      "entities": {
        "identity.user": ["*"],
        "identity.tenant": ["*"]
      }
    },
    "export": {
      "roles": ["*"],
      "entities": {
        "identity.user": ["*"],
        "identity.tenant": ["*"]
      }
    }
  },
  "identity": {
    "main": {
      "type": "oidc",
      "force-https": false,
      "redirect": "http://localhost:4200/login-redirect",
      "logout-redirect": "http://localhost:4200/",
      "url": "http://localhost:8090/oauth/openid//{{tenant}}/.well-known/openid-configuration",
      "issuer": "http://localhost:8090/oauth/openid/{{tenant}}",
      "profile": "http://localhost:8090/oauth/openid/{{tenant}}/me",
      "client-id": "phylax-ui",
      "scope": "openid profile email offline_access",
      "roles-claim": "groups",
      "audience": ["phylax-ui", "phylax-api"],
      "ph-audience": ["phylax-ui", "phylax-api"],
      "persistent": false
    }
  },
  "telemetry": {
    "name": "phylax-ui",
    "environment": "local",
    "exporter": {
      "tracer": {
        "url": "http://localhost:8090/v1/traces"
      },
      "logger": {
        "url": "http://localhost:8090/v1/logs"
      }
    }
  }
}
