{
  "meta": {
    "title": "config de phylax"
  },
  "api": {
    "net-civeira-phylax": {
      "identity": "main",
      "url": "http://localhost:8090/api"
    }
  },
  "i18n": {
    "available-langs": ["es", "pt", "fr", "de"]
  },
  "identity": {
    "main": {
      "type": "oidc",
      "force-https": false,
      "url": "http://localhost:8090/oauth/openid/{{tenant}}/.well-known/openid-configuration",
      "issuer": "http://localhost:8090/oauth/openid/{{tenant}}",
      "client-id": "phylax-ui",
      "scope": "openid profile email",
      "audience": ["phylax-ui", "phylax-api"],
      "ph-audience": ["phylax-ui", "phylax-api"],
      "persistent": true,
      "pkce": false
    }
  },
  "telemetry": {
    "name": "",
    "exporter": {
      "tracer": {
        "url": "https://xxxxxxx/v1/traces",
        "headers": {
          "x-honeycomb-team": "xxxx"
        }
      },
      "logger": {
        "url": "https://xxxxxx/v1/logs",
        "headers": {
          "x-honeycomb-team": "xxxx"
        }
      }
    }
  }
}
